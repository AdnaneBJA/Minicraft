{
  "uid": "minicraft-player",
  "title": "Minicraft: player experience",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "minicraft"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "A probe on the server's own machine joins the world every 30 s as a **hidden observer** (no player sees it) and times 10 pings through the server's 60 Hz tick loop: the path a key press takes. It measures the server, Caddy and TLS, **not the internet distance** to a player: add your own round trip (about 30 ms from the same part of the continent). Targets: 99% of runs succeed, 99% of joins under 1 s, 99% of pings under 50 ms, over the last hour."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Probe runs ok (1 h)",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:probe_success:ratio_1h",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Share of probe runs that ended ok.",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
